# Copy this file to .env and fill in values if you want real AI responses.
# The app works perfectly fine WITHOUT any keys — it falls back to a built-in
# offline "mock AI" (template + keyword based) so the demo never breaks
# because of network/API issues during judging.

PORT=4000

# Optional: if set, the doubt-chat and question-generator will call the real
# Anthropic API instead of the offline fallback.
ANTHROPIC_API_KEY=
